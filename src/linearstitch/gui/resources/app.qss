/* LinearStitch — modern application stylesheet */

* {
    font-family: "SF Pro Text", "Segoe UI", "Inter", -apple-system, sans-serif;
    font-size: 13px;
}

QMainWindow,
QDialog {
    background-color: #f5f6f8;
}

QLabel#HeaderLabel {
    font-size: 15px;
    font-weight: 600;
    color: #1f2329;
}

QLabel#SectionLabel {
    font-size: 11px;
    font-weight: 700;
    color: #6b7280;
    padding-left: 2px;
}

QFrame#Card {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 10px;
}

QListWidget,
QTextEdit,
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #d7dbe0;
    border-radius: 8px;
    padding: 6px;
    selection-background-color: #2f6fed;
    selection-color: #ffffff;
}

QListWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #2f6fed;
    color: #ffffff;
}

QTextEdit#LogPanel {
    font-family: "SF Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    background-color: #1e2228;
    color: #d6dae0;
    border: none;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #d0d5dc;
    border-radius: 8px;
    padding: 7px 14px;
    color: #1f2329;
}

QPushButton:hover {
    background-color: #f0f2f5;
}

QPushButton:pressed {
    background-color: #e4e7eb;
}

QPushButton#PrimaryButton {
    background-color: #2f6fed;
    border: 1px solid #2f6fed;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #2a63d4;
}

QPushButton#PrimaryButton:pressed {
    background-color: #234fab;
}

QPushButton:disabled {
    background-color: #f0f1f3;
    color: #9aa0a6;
    border-color: #e3e6ea;
}

QCheckBox {
    spacing: 8px;
    color: #2b2f36;
    padding: 3px 0;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid #c2c8d0;
    border-radius: 5px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #2f6fed;
    border-color: #2f6fed;
}

QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #e3e6ea;
    height: 10px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2f6fed;
    border-radius: 6px;
}

QStatusBar {
    background-color: #eef0f3;
    color: #4b5563;
}

QMenuBar {
    background-color: #f5f6f8;
}

/* ---- Toolbar, splitter and results tabs ---- */

QToolBar#ActionToolBar {
    background-color: #fbfbfc;
    border: none;
    border-bottom: 1px solid #e3e6ea;
    spacing: 10px;
    padding: 10px 14px;
}

QToolBar#ActionToolBar QPushButton {
    min-height: 18px;
    padding: 8px 16px;
    font-weight: 500;
}

QToolBar#ActionToolBar QPushButton#PrimaryButton {
    padding: 8px 22px;
}

QScrollArea#ControlsScrollArea,
QScrollArea#ControlsScrollArea > QWidget > QWidget {
    background-color: #f5f6f8;
}

QSplitter#MainSplitter::handle {
    background-color: #dfe3e8;
    height: 6px;
}

QSplitter#MainSplitter::handle:hover {
    background-color: #c2c8d0;
}

QTabWidget#ResultsTabs::pane {
    border: none;
    border-top: 1px solid #d7dbe0;
}

QTabWidget#ResultsTabs::tab-bar {
    alignment: left;
    left: 8px;
}

QTabWidget#ResultsTabs QTabBar::tab {
    background-color: #eef0f3;
    color: #4b5563;
    border: 1px solid #d7dbe0;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    min-width: 72px;
    padding: 4px 12px;
    margin-right: 2px;
    font-size: 12px;
    font-weight: 600;
}

QTabWidget#ResultsTabs QTabBar::tab:selected {
    background-color: #2f6fed;
    color: #ffffff;
    border-color: #2f6fed;
}

/* ---- Preview panel ---- */

QScrollArea#PreviewScrollArea {
    background-color: #282c34;
    border: none;
}

QLabel#PreviewLabel {
    background-color: #282c34;
    color: #6b7280;
    font-size: 12px;
}
